# Copy to .env (never commit .env) and fill in.

# --- AI ---
GEMINI_API_KEY=
CHATBOT_PROVIDER=gemini

# --- Authentication ---
# Production:  AUTH_MODE=supabase  APP_ENV=production  SUPABASE_JWT_SECRET=<project JWT secret>
# Your laptop: AUTH_MODE=dev       APP_ENV=development ALLOW_DEV_AUTH=true
AUTH_MODE=dev
APP_ENV=development
ALLOW_DEV_AUTH=true
SUPABASE_JWT_SECRET=

# --- Data ---
# Seed data is flagged as demo. Keep this false in production.
ALLOW_DEMO_DATA=true
REPORTING_TIMEZONE=Asia/Karachi

# --- Knowledge base ---
EMBEDDING_MODEL=gemini-embedding-001
KB_THRESHOLD=0.60
KB_TOP_K=4
