# AI Healthcare Assistant - Environment Configuration
# Project: AI Healthcare Assistant & Smart Appointment Platform
# Sprint: Sprint 1 (September 7, 2026)

# Model & API Service URLs
AI_MODEL_SERVICE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here

# Vector Store / RAG Configuration
VECTOR_STORE_PROVIDER=chromadb
VECTOR_STORE_PATH=./healthcare-platform/data/vector_store
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Backend .NET API Integration Settings
DOTNET_BACKEND_API_URL=http://localhost:5000/api
CONFIDENCE_THRESHOLD=0.35
PORT=5000