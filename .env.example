# --- Service identity ---
SERVICE_NAME=hisabdo-ai-service
SERVICE_VERSION=0.1.0-poc

# --- Service-to-service auth ---
# Placeholder shared-secret check for local development.
# Never use a real secret in this file.
INTERNAL_SERVICE_TOKEN=change-me-dev-token

# --- Chatbot / LLM provider ---
# "mock" works without credentials and is the default for local/offline use.
# "anthropic" / "openai" require the appropriate API key.
LLM_PROVIDER=mock

# --- OpenAI-compatible LLM settings ---
# Optional. Leave blank when using mock/offline mode.
OPENAI_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
# Optional. Leave blank unless using Anthropic.
ANTHROPIC_API_KEY=

# --- Categorization ---
CATEGORIZATION_CONFIDENCE_THRESHOLD=0.55