# --- Service identity ---
SERVICE_NAME=hisabdo-ai-service
SERVICE_VERSION=0.1.0-poc

# --- Service-to-service auth (Day 15 blocker: mechanism not yet decided) ---
# Placeholder shared-secret check per Day 16 continuity plan.
# The backend must send this value in the "X-Internal-Token" header.
INTERNAL_SERVICE_TOKEN=change-me-dev-token

# --- Chatbot / LLM provider (Day 15 blocker: provider not yet selected) ---
# "mock" works with no credentials and is the Day 16 POC default.
# "anthropic" / "openai" are wired but require a real key to actually call out.
# GROQ_API_KEY is the shared key both financial_assistant's chatbot and
# xictek_website_assistant fall back to by default (see the XICTEK section
# below for giving the website assistant its own, separate key instead).
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Categorization ---
CATEGORIZATION_CONFIDENCE_THRESHOLD=0.55

# --- Day 28 Data Pipeline & Validation Config ---
DATASET_PATH=data/cleaned_production_dataset_day28.json
MAX_TRANSACTION_LIMIT=1000
CONFIDENCE_THRESHOLD=0.35

# --- XICTEK website assistant (src/xictek_website_assistant) ---
# By default this module reuses the shared GROQ_API_KEY / LLM_PROVIDER
# above (same as HisabDo's chatbot). To give it its own, separate Groq
# key instead — e.g. so the public website bot can be rate-limited or
# revoked independently of the product chatbot — set these two; leave
# them unset to keep sharing the values above.
# XICTEK_GROQ_API_KEY=
# XICTEK_LLM_PROVIDER=groq
# Every other XICTEK_* var below has a sane default in config.py — only
# set one here if you need to override it for local testing (e.g.
# widening XICTEK_ALLOWED_CRAWL_DOMAINS while re-indexing).
# XICTEK_RATE_LIMIT=20/minute
#
# Required (uncommented) to test widget/demo.html locally -- it's served
# on a different port than the API, which browsers treat as a different
# origin, so this must be set or the widget's requests get silently
# blocked by the browser. Production: set to the real xicteksystems.com
# origin instead. See xictek_website_assistant/README.md's "Local widget
# testing" section.
XICTEK_WIDGET_ALLOWED_ORIGINS=["http://localhost:5500"]
