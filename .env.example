# HisabDo AI Financial Assistant — environment variable reference.
#
# COPY THIS FILE TO .env ONLY if you want to enable optional features.
# Never commit real keys. The assistant works fully offline without these.

# Optional: enables the LLM-polish pass (enhancement only; deterministic
# responses are always the fallback). **FAKE EXAMPLE VALUE** — do not use a
# real key here.
OPENAI_API_KEY=sk-your-fake-key-here

# Optional: OpenAI-compatible base URL (defaults to https://api.openai.com/v1)
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1

# Optional LLM model name used by the polish pass.
OPENAI_MODEL=gpt-4o-mini