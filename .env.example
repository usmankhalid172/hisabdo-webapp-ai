# --- Service identity ---
SERVICE_NAME=hisabdo-ai-service
SERVICE_VERSION=0.1.0-poc

# --- Service-to-service auth (Day 15 blocker: mechanism not yet decided) ---
# Placeholder shared-secret check per Day 16 continuity plan.
# The backend must send this value in the "X-Internal-Token" header.
INTERNAL_SERVICE_TOKEN=change-me-dev-token

# --- Chatbot / LLM provider (Day 15 blocker: provider not yet selected) ---
# "mock" works with no credentials and is the Day 16 POC default.
# "anthropic" / "openai" are wired but require a real key to actually call out.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Financial Assistant module (Muhammad Hamza Nawaz, Day 15-28) ---
# Read directly by src/financial_assistant/llm_service.py's _get_client().
# Separate from OPENAI_API_KEY/ANTHROPIC_API_KEY above since this module's
# provider assumption (OpenAI-compatible) was set independently pending
# Asim Javed's provider research, which never landed a branch/PR across
# Days 15-28. Leave blank to run this module against mocked clients only
# (all of its own tests do this, so a real key is not required to test it).
FINANCIAL_ASSISTANT_LLM_API_KEY=

# --- Categorization ---
CATEGORIZATION_CONFIDENCE_THRESHOLD=0.55