# Set these to your REAL Blog & News chatbot API details
QA_BASE_URL=https://your-chatbot-host.example
QA_CHAT_PATH=/chat
QA_DOMAIN=www.xicteksystems.com
# Comma-separated approved path prefixes. Add /news/ only if it is a real approved path.
QA_ALLOWED_PREFIXES=/blog/
QA_RESPONSE_TEXT_FIELD=reply
QA_HISTORY_MODE=payload
QA_TIMEOUT=60
